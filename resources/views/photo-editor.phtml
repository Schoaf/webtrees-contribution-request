<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;

/**
 * Turn a photo by 90° and put a square frame around the person - for the guest before sending and
 * for the reviewer before applying, so a photo arrives ready to use. The image is turned on the
 * server (photo_turns); the frame (crop_*) is in pixels of the turned image, as GEDCOM 7 CROP.
 * Without JavaScript only the file field remains.
 *
 * @var string                                      $id         unique per page
 * @var string                                      $src        image to start with ('' = wait for a file)
 * @var array{top:int,left:int,height:int,width:int}|null $crop  frame to start with
 * @var string                                      $file_input id of a file input that loads the image, or ''
 */

$crop ??= null;
$file_input ??= '';

?>
<div class="wtshare-photo-editor" id="<?= e($id) ?>" data-src="<?= e($src) ?>" data-file-input="<?= e($file_input) ?>"
     data-crop="<?= e($crop === null ? '' : json_encode($crop, JSON_THROW_ON_ERROR)) ?>" style="<?= $src === '' ? 'display:none' : '' ?>">
  <div class="wtshare-photo-stage">
    <canvas></canvas>
    <div class="wtshare-frame" hidden>
      <span class="wtshare-frame-handle" title="<?= e(I18N::translate('Größe ändern')) ?>">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" transform="rotate(90 12 12)" d="M21 11V3h-8l3.29 3.29-10 10L3 13v8h8l-3.29-3.29 10-10z"/></svg>
      </span>
    </div>
  </div>
  <div class="wtshare-photo-tools">
    <button type="button" class="wtshare-tool" data-action="turn">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M15.55 5.55 11 1v3.07C7.06 4.56 4 7.92 4 12s3.05 7.44 7 7.93v-2.02c-2.84-.48-5-2.94-5-5.91s2.16-5.43 5-5.91V10l4.55-4.45zM19.93 11a7.906 7.906 0 0 0-1.62-3.89l-1.42 1.42c.54.75.88 1.6 1.02 2.47h2.02zM13 17.9v2.02c1.39-.17 2.74-.71 3.9-1.61l-1.44-1.44c-.75.54-1.59.89-2.46 1.03zm3.89-2.42 1.42 1.41c.9-1.16 1.45-2.5 1.62-3.89h-2.02c-.14.87-.48 1.72-1.02 2.48z"/></svg>
      <?= I18N::translate('Drehen') ?>
    </button>
    <button type="button" class="wtshare-tool" data-action="frame"
            data-on="<?= e(I18N::translate('Rahmen entfernen')) ?>" data-off="<?= e(I18N::translate('Rahmen um die Person')) ?>"></button>
  </div>
  <input type="hidden" name="photo_turns" value="0">
  <input type="hidden" name="crop_top" value="">
  <input type="hidden" name="crop_left" value="">
  <input type="hidden" name="crop_height" value="">
  <input type="hidden" name="crop_width" value="">
</div>
<style>
  .wtshare-photo-editor { margin: 12px 0; }
  .wtshare-photo-stage { position: relative; touch-action: none; user-select: none; }
  .wtshare-photo-stage canvas { display: block; width: 100%; border-radius: 8px; background: #000; }
  .wtshare-frame {
    position: absolute; border: 2.5px solid #fff; border-radius: 12px; cursor: move;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, .45), 0 0 6px rgba(0, 0, 0, .4);
  }
  .wtshare-photo-stage { overflow: hidden; border-radius: 8px; }
  .wtshare-frame-handle {
    position: absolute; right: -16px; bottom: -16px; width: 32px; height: 32px; border-radius: 50%;
    background: #fff; color: #1B1B1F; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .4); cursor: nwse-resize;
  }
  .wtshare-photo-tools { display: flex; gap: 8px; justify-content: center; margin-top: 8px; flex-wrap: wrap; }
  .wtshare-photo-editor .wtshare-tool {
    width: auto; display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px;
    border: 1px solid #E7E0EC; background: #fff; color: #1B1B1F; font: inherit; font-size: 14px; cursor: pointer;
  }
</style>
<script>
  (function (root) {
    var canvas = root.querySelector('canvas');
    var frame = root.querySelector('.wtshare-frame');
    var handle = root.querySelector('.wtshare-frame-handle');
    var frameButton = root.querySelector('[data-action="frame"]');
    var field = function (name) { return root.querySelector('input[name="' + name + '"]'); };
    var image = new Image();
    var turns = 0;
    var crop = root.dataset.crop ? JSON.parse(root.dataset.crop) : null;
    var scale = 1;

    // Size of the image as shown: turned by `turns` quarter turns.
    function size() {
      return turns % 2 ? {w: image.naturalHeight, h: image.naturalWidth} : {w: image.naturalWidth, h: image.naturalHeight};
    }

    function save() {
      field('photo_turns').value = String(turns);
      ['top', 'left', 'height', 'width'].forEach(function (key) {
        field('crop_' + key).value = crop ? String(Math.round(crop[key])) : '';
      });
      frameButton.textContent = crop ? frameButton.dataset.on : frameButton.dataset.off;
    }

    function draw() {
      if (!image.naturalWidth) { return; }
      var s = size();
      var width = canvas.parentElement.clientWidth || 320;
      scale = width / s.w;
      canvas.width = Math.round(s.w * scale);
      canvas.height = Math.round(s.h * scale);
      var ctx = canvas.getContext('2d');
      ctx.save();
      ctx.translate(canvas.width / 2, canvas.height / 2);
      ctx.rotate(turns * Math.PI / 2);
      ctx.drawImage(image, -image.naturalWidth * scale / 2, -image.naturalHeight * scale / 2,
        image.naturalWidth * scale, image.naturalHeight * scale);
      ctx.restore();
      frame.hidden = !crop;
      if (crop) {
        frame.style.left = crop.left * scale + 'px';
        frame.style.top = crop.top * scale + 'px';
        frame.style.width = crop.width * scale + 'px';
        frame.style.height = crop.height * scale + 'px';
      }
      save();
    }

    function clamp(c) {
      var s = size();
      var side = Math.max(16 / scale, Math.min(c.width, s.w, s.h));
      return {
        left: Math.min(Math.max(0, c.left), s.w - side),
        top: Math.min(Math.max(0, c.top), s.h - side),
        width: side, height: side,
      };
    }

    function centred() {
      var s = size();
      var side = Math.min(s.w, s.h) / 2;
      return {left: (s.w - side) / 2, top: (s.h - side) / 2, width: side, height: side};
    }

    function load(src) {
      image.onload = function () {
        root.style.display = '';
        crop = crop ? clamp(crop) : crop;
        draw();
      };
      image.src = src;
    }

    root.querySelector('[data-action="turn"]').addEventListener('click', function () {
      var s = size();
      if (crop) {
        // A quarter turn clockwise: the left edge becomes the top one, the height the width.
        crop = {left: s.h - crop.top - crop.height, top: crop.left, width: crop.height, height: crop.width};
      }
      turns = (turns + 1) % 4;
      draw();
    });

    frameButton.addEventListener('click', function () {
      crop = crop ? null : centred();
      draw();
    });

    function drag(element, onMove) {
      element.addEventListener('pointerdown', function (event) {
        event.preventDefault();
        event.stopPropagation();
        var startX = event.clientX, startY = event.clientY, start = Object.assign({}, crop);
        element.setPointerCapture(event.pointerId);
        function move(e) { onMove(start, (e.clientX - startX) / scale, (e.clientY - startY) / scale); draw(); }
        function up() { element.removeEventListener('pointermove', move); element.removeEventListener('pointerup', up); }
        element.addEventListener('pointermove', move);
        element.addEventListener('pointerup', up);
      });
    }
    drag(frame, function (start, dx, dy) {
      crop = clamp({left: start.left + dx, top: start.top + dy, width: start.width, height: start.height});
    });
    drag(handle, function (start, dx, dy) {
      var side = start.width + (dx + dy) / 2;
      crop = clamp({left: start.left, top: start.top, width: side, height: side});
    });

    window.addEventListener('resize', draw);

    if (root.dataset.fileInput) {
      document.getElementById(root.dataset.fileInput).addEventListener('change', function (event) {
        var file = event.target.files && event.target.files[0];
        if (!file) { return; }
        turns = 0;
        crop = null;
        image.onload = function () {
          root.style.display = '';
          crop = centred();
          draw();
        };
        image.src = URL.createObjectURL(file);
      });
    }
    if (root.dataset.src) { load(root.dataset.src); }
    save();
  })(document.getElementById(<?= json_encode($id, JSON_THROW_ON_ERROR) ?>));
</script>
